{
 "_source": "JPL Horizons API (ssd.jpl.nasa.gov/api/horizons.api)",
 "_query": "EPHEM_TYPE=VECTORS, CENTER=@<parent body centre>, REF_PLANE=ECLIPTIC, REF_SYSTEM=ICRF, OUT_UNITS=KM-S, VEC_CORR=NONE, VEC_TABLE=2, CSV_FORMAT=YES, TLIST_TYPE=JD, TIME_TYPE=TDB, COMMAND=<hid>",
 "_center": "Per body: the PARENT PLANET body centre (@399, @599, @699, @799, @899, @999), not a barycentre. Every state is parent-relative, which is the frame src/sim/catalog.ts builds moon elements in.",
 "_frame": "Ecliptic of J2000.0, ICRF orientation (Horizons \"Reference frame: Ecliptic of J2000.0\")",
 "_units": "km, km/s",
 "_targets": "20 satellites spanning every source frame the catalog converts from (ecliptic, equatorial, laplace) and every parent with moons in the catalog.",
 "_ephemeris": "DE441 plus the per-system satellite ephemerides Horizons selects (JUP365, SAT441, URA182/URA184, NEP097/NEP105, PLU060)",
 "_timescale": "TDB (TIME_TYPE=TDB); JD values are JDTDB",
 "_retrieved": "2026-08-27",
 "_epochs": [
  {
   "key": "j2000",
   "jd": 2451545,
   "label": "2000-01-01 12:00 TDB (J2000)",
   "why": "drift baseline: T = 0, so every secular term vanishes identically. This is the ONLY epoch the previous fixture had, and the reason it could not see a secular defect."
  },
  {
   "key": "p30d",
   "jd": 2451575,
   "label": "2000-01-31 12:00 TDB (J2000 + 30 d)",
   "why": "shortest baseline: the fastest apsidal precessors (Io 0.739 deg/d, Enceladus 0.338 deg/d) are still far from the 180 deg fold, so position error is monotone in rate error here."
  },
  {
   "key": "p180d",
   "jd": 2451725,
   "label": "2000-06-29 12:00 TDB (J2000 + 180 d)",
   "why": "the Moon reaches 20 deg of double-counted slip; Ariel 6 deg."
  },
  {
   "key": "p1y",
   "jd": 2451910.25,
   "label": "2000-12-31 18:00 TDB (J2000 + 1 Julian yr)",
   "why": "the headline epoch: the Moon reaches 40.7 deg of slip (2.7e5 km, 66% of its orbit radius)."
  },
  {
   "key": "p5y",
   "jd": 2453371.25,
   "label": "2004-12-31 18:00 TDB (J2000 + 5 Julian yr)",
   "why": "mid-rate bodies (Titania, Miranda) accumulate a measurable slip; the Moon has folded past 180 deg by here, which is why a long baseline alone aliases."
  },
  {
   "key": "y2025",
   "jd": 2460676.5,
   "label": "2025-01-01 00:00 TDB",
   "why": "Cordelia epoch-2025 element set is evaluated at its OWN epoch: the only epoch where its 0.6-yr node is meaningful (plane error 0.02 deg here vs 118 deg at J2000). Also a 25-yr baseline for the slow precessors."
  },
  {
   "key": "y2026",
   "jd": 2461041.5,
   "label": "2026-01-01 00:00 TDB",
   "why": "Cordelia epoch + 1 yr, which pins its node RATE; longest baseline, so the phase-immune plane check does the work for everything else."
  }
 ],
