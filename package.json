{
  "name": "solar-system-realistic-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "node ./scripts/dev-full.mjs",
    "dev:ui": "node ./scripts/run-ui-dev.mjs",
    "build": "vite build",
    "test": "vitest run",
    "typecheck:ratchet": "node ./scripts/ci/typescript-error-ratchet.mjs",
    "phase1:asteroid-dataset": "python3 scripts/build_asteroid_phase1_dataset.py",
    "typecheck": "tsc --project tsconfig.json --strict --noEmit",
    "preview": "vite preview",
    "update:moons": "node ./scripts/update-moons-data.mjs",
    "generate:moon-ephemeris": "python3 ./scripts/generate_moon_ephemeris.py --write",
    "verify:moon-ephemeris": "python3 ./scripts/generate_moon_ephemeris.py --check",
    "ingest:moon-textures": "node ./scripts/ingest-moon-textures.mjs",
    "verify:moon-frames": "node ./scripts/verify-moon-frames.mjs",
    "verify:planet-positions": "node ./scripts/verify-planet-positions.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "three": "^0.182.0"
  }
}
